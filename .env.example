# =============================================================
# PATCHORA — Environment Variables Example
# Copy to .env and fill in values. Never commit .env to git.
# =============================================================

# ---- Application ----
APP_ENV=development           # development | staging | production
APP_NAME="PATCHORA"
APP_VERSION=0.1.0
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
DEBUG=true
LOG_LEVEL=INFO

# ---- Authentication & Security ----
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# ---- Database ----
# PostgreSQL (preferred):
DATABASE_URL=postgresql+asyncpg://bughunter:password@localhost:5432/bughunter_db
# SQLite fallback (local dev only, set USE_SQLITE=true):
USE_SQLITE=false
SQLITE_PATH=./bughunter.db

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Redis (future — Celery background jobs) ----
REDIS_URL=redis://localhost:6379/0

# ---- PostgreSQL (Docker Compose) ----
POSTGRES_DB=bughunter_db
POSTGRES_USER=bughunter
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# ---- Payment & Billing (Stripe / Sandbox) ----
PAYMENT_PROVIDER=sandbox        # sandbox | stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_CURRENCY=USD

# ---- AI Bug-Fixing & Remediation Engine ----
AI_PROVIDER=deterministic_rules  # deterministic_rules | gemini | openai | anthropic
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL_NAME=gemini-1.5-pro
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2
REMEDIATION_ISOLATION_WORKSPACE=./remediation_sandboxes

# ---- Git Integration, Staging & Deployment (Phase 9) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_DEFAULT_BRANCH=main
ENABLE_PRODUCTION_DEPLOYMENT=false  # STRICT SAFETY: Disabled by default
ENABLE_STAGING_DEPLOYMENT=true

# ---- Client Finder Automation & Compliant Outreach (Phase 10) ----
OUTREACH_PROVIDER=sandbox_logger  # sandbox_logger | smtp
OUTREACH_FROM_EMAIL=security@patchora.io
OUTREACH_FROM_NAME="PATCHORA Security Team"
OUTREACH_DAILY_RATE_LIMIT=50
OUTREACH_COMPLIANCE_ADDRESS="PATCHORA Inc., 100 Cyber Defense Way, Suite 400, San Francisco, CA 94105"
OUTREACH_OPT_OUT_BASE_URL=http://localhost:5173/opt-out

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME="PATCHORA"
